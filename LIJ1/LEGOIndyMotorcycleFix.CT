            <CheatEntry>
              <ID>228</ID>
              <Description>"Give P1 item"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
alloc(callFunc,2048)
createthread(callFunc)

alloc(ItemTable, 104)
registersymbol(ItemTable)

ItemTable:
dd 3401D0   // bazooka
dd 340A50   // crossbow
dd 33F840   // pistol
dd 33F950   // walkietalkie
dd 33FA60   // crank
dd 33FB70   // book
dd 33FC80   // wrench
dd 33FD90   // grenade
dd 33FEA0   // dynamite
dd 33FFB0   // banana
dd 3400C0   // shovel
dd 3402E0   // torch
dd 3403F0   // grail sword
dd 340500   // sword
dd 340610   // spear
dd 340720   // bottle
dd 340830   // rifle
dd 340940   // machinegun
dd 340B60   // blacksleep
dd 340C70   // barrel
dd 340D80   // bush
dd 340E90   // red brick
dd 340FA0   // chair
dd 3410B0   // raven stool
dd 3411C0   // rock
dd 3412D0   // holy grail

callFunc:
pushad
pushfd

// [LEGOIndy.exe+006ADEE4] is player 1 struct pointer


// Offset to get ebp
mov ebp, [LEGOIndy.exe+006ADEE4]
add ebp, EB1068

// Uses the pointer to player struct
mov esi, [LEGOIndy.exe+006ADEE4]

// add offset to item here




// Item functions

mov eax,[SelectedItemP1]      // index (0–25)
mov edx,ItemTable
add esi,[edx+eax*4]

// offset to fix for unmodded files
sub esi, 1800

//player struct offset.
mov edi, [LEGOIndy.exe+006ADEE4]
// // Adding the offset for player 2 here
// add edi, 15B0



// float argument
fld dword ptr [esi+40]
sub esp,4
fstp dword ptr [esp]

// remaining args
push 00
push 01
push 01
push ebp
push esi
push edi
// LEGOIndy.exe+1DA25B is
// where the give item function is called
call LEGOIndy.exe+1D82C0
add esp,1C   // 7 args × 4 bytes

popfd
popad
ret




[DISABLE]
dealloc(callFunc)
</AssemblerScript>
