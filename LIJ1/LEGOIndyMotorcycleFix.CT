alloc(ItemTable, 104)
registersymbol(ItemTable)

ItemTable:
dd 3401D0   // bazooka
dd 340A50   // crossbow
dd 33F840   // pistol
dd 33F950   // walkietalkie
dd 33FA60   // crank
dd 33FB70   // book
dd 33FC80   // wrench
dd 33FD90   // grenade
dd 33FEA0   // dynamite
dd 33FFB0   // banana
dd 3400C0   // shovel
