  </CheatEntries>
  <UserdefinedSymbols/>
  <LuaScript>local addr = getAddress("coordBuffer")
local totalWrites = readQword("bufferIndex") or 0
local maxEntries = 16384
local countToRead = math.min(totalWrites, maxEntries)

local file = io.open("coord_history.csv", "w")
file:write("Snapshot_Index,X_Float,Y_Float,Z_Float,X_Hex,Y_Hex,Z_Hex\n")

for i = 0, countToRead - 1 do
    local entryAddr = addr + (i * 16)

    -- Read 32-bit floats directly from buffer
    local xVal = readFloat(entryAddr) or 0
    local yVal = readFloat(entryAddr + 4) or 0
    local zVal = readFloat(entryAddr + 8) or 0

    local xHex = string.format("0x%08X", readInteger(entryAddr) or 0)
    local yHex = string.format("0x%08X", readInteger(entryAddr + 4) or 0)
    local zHex = string.format("0x%08X", readInteger(entryAddr + 8) or 0)

    file:write(string.format("%d,%.6f,%.6f,%.6f,%s,%s,%s\n", i, xVal, yVal, zVal, xHex, yHex, zHex))
end

file:close()
print("Exported " .. countToRead .. " snapshots to coord_history.csv!")
print(string.format("NaN Count: %d | Last NaN Bits: 0x%08X", readQword("nanCount") or 0, readInteger("lastNanBits") or 0))
</LuaScript>
</CheatTable>
