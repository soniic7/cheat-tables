            </CheatEntry>
            <CheatEntry>
              <ID>151</ID>
              <Description>"P1 Max Hearts"</Description>
              <LastState Value="4" RealAddress="18EE7252"/>
              <ShowAsSigned>0</ShowAsSigned>
              <Color>000000</Color>
              <VariableType>Byte</VariableType>
              <Address>"LEGOIndy.exe"+006ADEE4</Address>
