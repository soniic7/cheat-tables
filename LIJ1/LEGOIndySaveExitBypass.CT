        </CheatEntry>
        <CheatEntry>
          <ID>250</ID>
          <Description>"Skip cutscene (bind hotkey)"</Description>
          <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
          <LastState Value="" RealAddress="00000000"/>
          <GroupHeader>1</GroupHeader>
          <Hotkeys>
            <Hotkey>
              <Action>Activate</Action>
              <Keys>
                <Key>67</Key>
              </Keys>
              <ID>0</ID>
            </Hotkey>
          </Hotkeys>
        </CheatEntry>
        <CheatEntry>
          <ID>336</ID>
          <Description>"End cutscene track"</Description>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
// 1. ALLOCATE AND SETUP VARIABLES FIRST
alloc(doAudioFadeout, 4)
registersymbol(doAudioFadeout)

doAudioFadeout:
  dd 0  // Default 0

// 2. ALLOCATE AND SETUP THE THREAD
alloc(CallEndTrack, 256)
createthread(CallEndTrack) // Thread name now matches the alloc name

CallEndTrack:
  // Push param_3 (Fade flag).
  // Brackets ensure we push the VALUE (1 or 0), not the memory address!
  push [doAudioFadeout]

  // Push param_2 (Bitmask).
  push 0x10

  // Set ECX to param_1 (the NuMusic 'this' pointer).
  mov ecx, 00A90A08

  // Call the function (NuMusic::StopTrack_Alt).
  mov eax, 0052cc20
  call eax

  // End thread cleanly.
  ret


[DISABLE]
// CLEANUP
unregistersymbol(doAudioFadeout)
dealloc(doAudioFadeout)
dealloc(CallEndTrack)
</AssemblerScript>
        </CheatEntry>
