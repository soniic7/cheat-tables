    <CheatEntry>
      <ID>294</ID>
      <Description>"Timer"</Description>
      <Options moManualExpandCollapse="1"/>
      <LastState Value="" RealAddress="00000000"/>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>268</ID>
          <Description>"LivesplitIGT (Enable timer)"</Description>
          <Options moAlwaysHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
alloc(newmem, 2048)
label(returnhere)
label(originalcode)
label(exit)
label(skip_timers)

label(position1)
label(position2)
label(isOnBottom1)
label(isOnBottom2)
label(showHour1)
label(showHour2)

registerSymbol(position1)
registerSymbol(position2)
registerSymbol(isOnBottom1)
registerSymbol(isOnBottom2)
registerSymbol(showHour1)
registerSymbol(showHour2)

newmem:
pushfd
pushad

// Flush FPU Stack to prevent math overflow
fninit

// Keep stack aligned for safe 3D/SSE math
mov ebp, esp
and esp, 0xFFFFFFF0

// Load base pointer for Timer 1
mov eax,[LEGOIndy.exe+006ADEE4]
test eax,eax
je skip_timers

// ==========================================
// TIMER 1 (Total Time)
// ==========================================
push dword ptr [showHour1]
push dword ptr [isOnBottom1]
push [eax+0BD3D2]
push [eax+0BD3CA]
push dword ptr [position1]
call 004DE5F0
add esp, 14

// ==========================================
// TIMER 2 (Level Time)
// ==========================================
// RELOAD EAX BECAUSE THE PREVIOUS CALL TRASHED IT!
mov eax,[LEGOIndy.exe+006ADEE4]
test eax,eax
je skip_timers

push dword ptr [showHour2]
push dword ptr [isOnBottom2]
push [eax+0BD3D6]
push [eax+0BD3CE]
push dword ptr [position2]
call 004DE5F0
add esp, 14

skip_timers:
mov esp, ebp
popad
popfd

originalcode:
call 0070dbf0

exit:
jmp returnhere

position1:
  dd (float)-0.85
position2:
  dd (float)-0.65
isOnBottom1:
  dd (int)1
isOnBottom2:
  dd (int)1
showHour1:
  dd (int)0
showHour2:
  dd (int)0

004e46c4:
jmp newmem
returnhere:

[DISABLE]
004e46c4:
db E8 27 95 22 00

unregisterSymbol(position1)
unregisterSymbol(position2)
unregisterSymbol(isOnBottom1)
unregisterSymbol(isOnBottom2)
unregisterSymbol(showHour1)
unregisterSymbol(showHour2)
dealloc(newmem)
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>295</ID>
              <Description>"Timer parameters (Customize timer)"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
// 1. Allocate ONE block of memory for everything
alloc(newmem,2048)

// 2. Register labels inside newmem for the Cheat Table
label(timer_alpha)
label(timer_color_blue)
label(timer_color_green)
label(timer_color_red)
label(timer_style)

label(dtimer_alpha)
label(dtimer_color_blue)
label(dtimer_color_green)
label(dtimer_color_red)
label(dtimer_style)

registerSymbol(timer_alpha)
registerSymbol(timer_color_blue)
registerSymbol(timer_color_green)
registerSymbol(timer_color_red)
registerSymbol(timer_style)

registerSymbol(dtimer_alpha)
registerSymbol(dtimer_color_blue)
registerSymbol(dtimer_color_green)
registerSymbol(dtimer_color_red)
registerSymbol(dtimer_style)

label(returnhere)
label(behind_timer)
label(exit_if)

// ==========================================
// CODE EXECUTION
// ==========================================
newmem:
cmp eax, 000000BF
jne behind_timer

// -&gt; AHEAD OF TIMER BLOCK
push [timer_alpha]
push [timer_color_blue]
push [timer_color_green]
push [timer_color_red]
push [timer_style]
jmp exit_if

// -&gt; BEHIND TIMER BLOCK
behind_timer:
push [dtimer_alpha]
push [dtimer_color_blue]
push [dtimer_color_green]
push [dtimer_color_red]
push [dtimer_style]

exit_if:
jmp returnhere

// ==========================================
// VARIABLES (Safely tucked away below the jump)
// ==========================================
timer_alpha:
  dd 00000080
timer_color_blue:
  dd 00000000
timer_color_green:
  dd 000000bf
timer_color_red:
  dd 000000FF
timer_style:
  dd 00000000

dtimer_alpha:
  dd 00000080
dtimer_color_blue:
  dd 00000000
dtimer_color_green:
  dd 0000001f
dtimer_color_red:
  dd 000000FF
dtimer_style:
  dd 00000000

// ==========================================
// INJECTION POINT
// ==========================================
"LEGOIndy.exe"+DE65F:
jmp newmem
// Hardcode the exact 10 NOPs needed to pad the 15 replaced bytes
db 90 90 90 90 90 90 90 90 90 90
returnhere:

[DISABLE]
"LEGOIndy.exe"+DE65F:
// Safely restore the exact original 15 bytes to prevent overwriting 'SUB ESP, 0x18'
// 68 80 00 00 00 | 6A 00 | 50 | 68 FF 00 00 00 | 6A 00
db 68 80 00 00 00 6A 00 50 68 FF 00 00 00 6A 00

unregisterSymbol(timer_alpha)
unregisterSymbol(timer_color_blue)
unregisterSymbol(timer_color_green)
unregisterSymbol(timer_color_red)
unregisterSymbol(timer_style)
unregisterSymbol(dtimer_alpha)
unregisterSymbol(dtimer_color_blue)
unregisterSymbol(dtimer_color_green)
unregisterSymbol(dtimer_color_red)
unregisterSymbol(dtimer_style)

dealloc(newmem)
</AssemblerScript>
