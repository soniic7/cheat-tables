        <CheatEntry>
          <ID>327</ID>
          <Description>"Mute cutscenes"</Description>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
alloc(pWorldInfo, 4)
registersymbol(pWorldInfo)

alloc(newmem, 512) // Bumped up size to 512 to safely hold both features
label(returnhere)
label(originalcode)

newmem:
  // -------------------------------------------------------------------------
  // STEP 1: STEAL THE WORLDINFO POINTER (From previous step)
  // -------------------------------------------------------------------------
  push eax
  mov eax, [esp+8]        // Grab param_1 (WORLDINFO_s*) from stack
  mov [pWorldInfo], eax   // Save it
  pop eax

  // -------------------------------------------------------------------------
  // STEP 2: AUTOMATICALLY CALL SETCLASSVOLUME
  // -------------------------------------------------------------------------
  push eax                // Save registers to prevent the game from crashing
  push ecx
  push edx

  push 00000000           // param_3: Volume (0.0f = Mute. Use 3F800000 for 1.0f)
  push 10                 // param_2: Bitmask (0x10)
  mov ecx, 00A90A08       // param_1: NuMusic 'this' pointer
  mov eax, 0052d9b0       // Function: NuMusic::SetClassVolume
  call eax                // Call the function (it cleans up its own stack arguments)

  pop edx                 // Restore registers to their exact original state
  pop ecx
  pop eax

originalcode:
  // -------------------------------------------------------------------------
  // STEP 3: EXECUTE OVERWRITTEN GAME INSTRUCTION
  // -------------------------------------------------------------------------
  mov eax, [00ace960]
  jmp returnhere

// Inject at the very top of CutScenes_Update
005ffe10:
  jmp newmem
returnhere:


[DISABLE]
005ffe10:
  mov eax, [00ace960]

unregistersymbol(pWorldInfo)
dealloc(pWorldInfo)
dealloc(newmem)
</AssemblerScript>
