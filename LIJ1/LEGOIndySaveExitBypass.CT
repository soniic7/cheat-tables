    <CheatEntry>
      <ID>51</ID>
      <Description>"Players"</Description>
      <Options moManualExpandCollapse="1"/>
      <LastState Value="" RealAddress="00000000"/>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>129</ID>
          <Description>"Player 1"</Description>
          <Options moManualExpandCollapse="1"/>
          <LastState Value="" RealAddress="00000000"/>
          <Color>FF0000</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>146</ID>
              <Description>"Enable respawn speedup"</Description>
              <LastState Value="" RealAddress="00000000"/>
              <GroupHeader>1</GroupHeader>
            </CheatEntry>
            <CheatEntry>
              <ID>75</ID>
              <Description>"P1 Health"</Description>
              <LastState Value="4" RealAddress="18EE7253"/>
              <ShowAsSigned>0</ShowAsSigned>
              <Color>000000</Color>
              <VariableType>Byte</VariableType>
              <Address>"LEGOIndy.exe"+006ADEE4</Address>
              <Offsets>
