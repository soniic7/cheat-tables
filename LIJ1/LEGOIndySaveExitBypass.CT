              </Offsets>
            </CheatEntry>
            <CheatEntry>
              <ID>228</ID>
              <Description>"Give P1 item"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
alloc(callFunc,2048)
createthread(callFunc)

alloc(ItemTable, 104)
registersymbol(ItemTable)

ItemTable:
dd 3401D0   // bazooka
dd 340A50   // crossbow
dd 33F840   // pistol
dd 33F950   // walkietalkie
dd 33FA60   // crank
dd 33FB70   // book
dd 33FC80   // wrench
dd 33FD90   // grenade
dd 33FEA0   // dynamite
dd 33FFB0   // banana
dd 3400C0   // shovel
dd 3402E0   // torch
dd 3403F0   // grail sword
dd 340500   // sword
dd 340610   // spear
dd 340720   // bottle
dd 340830   // rifle
dd 340940   // machinegun
dd 340B60   // blacksleep
dd 340C70   // barrel
dd 340D80   // bush
dd 340E90   // red brick
dd 340FA0   // chair
dd 3410B0   // raven stool
dd 3411C0   // rock
dd 3412D0   // holy grail

callFunc:
pushad
pushfd

// [LEGOIndy.exe+006ADEE4] is player 1 struct pointer


// Offset to get ebp
mov ebp, [LEGOIndy.exe+006ADEE4]
add ebp, EB1068

// Uses the pointer to player struct
