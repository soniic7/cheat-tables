            <CheatEntry>
              <ID>310</ID>
              <Description>"Auto Assemble script"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
// Create a thread to safely execute the call without locking up the main game loop
createthread(MenuCallSpawner)

alloc(MenuCallSpawner, 512)
label(exit)

MenuCallSpawner:
  // 1. Save the CPU state to prevent crashes
  pushad

  // 2. Push parameters from RIGHT to LEFT
  push ffffffff      // Parameter 3: 0xffffffff
  push 0             // Parameter 2: 0
  push #5         // Parameter 1: Pause Menu ID (uVar2)
                     // Note: Use '#' to tell Cheat Engine it's a decimal number (1011)
                     // Or use hex: push 3F3

  // 3. Call the function using its absolute address
  call 00696960

  // 4. Clean up the stack (if cdecl)
  // If the game crashes instantly upon executing the call, uncomment the line below:
add esp, C

  // 5. Restore CPU state
  popad

exit:
  ret

[DISABLE]
// No cleanup needed for a temporary execution thread
</AssemblerScript>
